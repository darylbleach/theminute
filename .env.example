# App
NEXT_PUBLIC_SITE_URL=https://theminute.lol
CONTACT_EMAIL=hello@theminute.lol

# Seeded first reign (page is never empty at launch)
FIRST_REIGN_URL=https://theminute.lol
FIRST_REIGN_TAGLINE=The whole homepage. One dollar a minute.
FIRST_REIGN_MINUTES=1440

# Postgres (Neon). Pooled DATABASE_URL is fine for the app.
DATABASE_URL=

# Stripe (test keys in development). Used for paid rooms and legacy auction routes.
# Do not commit real values.
STRIPE_SECRET_KEY=
STRIPE_WEBHOOK_SECRET=
NEXT_PUBLIC_STRIPE_PUBLISHABLE_KEY=

# Kill switch for the admin path /api/kill
KILL_SECRET=

# Vercel Cron sends Authorization: Bearer CRON_SECRET
CRON_SECRET=

# Resend — used to email paid-room magic links and six-digit codes.
# From address is CONTACT_EMAIL (hello@theminute.lol). Verify that domain in Resend.
# If this is unset, /login still creates the one-time token but returns an error
# telling you to configure Resend. Do not add a second mailer.
RESEND_API_KEY=
